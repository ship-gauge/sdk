{
  "name": "@shipgauge/node",
  "version": "0.1.0",
  "description": "ShipGauge Node.js SDK for LLM cost tracking and budget guardrails",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ship-gauge/sdk.git",
    "directory": "packages/node"
  },
  "keywords": ["shipgauge", "openai", "anthropic", "llm", "cost", "budget"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "prepublishOnly": "pnpm build"
  },
  "files": ["dist", "README.md"],
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
